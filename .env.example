# Copy this file to .env and fill in the placeholders. Real .env is gitignored.
#
# All path variables must be absolute. The example paths below assume a
# working-dir tree under C:\blueprism\OnlineTIAWorkingDir — adjust to taste.

# ----- Working directories (operator creates these once; see README) -----

# Customer-facing pipeline (run.py primary stage)
INPUT_DIR=C:\blueprism\OnlineTIAWorkingDir\InputCustomerResponseExcel
INTERMEDIATE_JSON_DIR=C:\blueprism\OnlineTIAWorkingDir\IntermediateCustomerResponseJson
PROCESSING_DIR=C:\blueprism\OnlineTIAWorkingDir\Processing
PROCESSED_DIR=C:\blueprism\OnlineTIAWorkingDir\Processed
OUTPUT_REPORT_DIR=C:\blueprism\OnlineTIAWorkingDir\OutputReport

# Reference pipeline (run.py reference + RAG-sync stages)
REFERENCE_TO_BE_LOADED_DIR=C:\blueprism\OnlineTIAWorkingDir\ReferenceToBeLoaded
REFERENCE_LOADED_DIR=C:\blueprism\OnlineTIAWorkingDir\ReferenceLoaded
REFERENCE_JSON_DIR=C:\blueprism\OnlineTIAWorkingDir\ReferenceJson
REFERENCE_JSON_EXTRACTED_DIR=C:\blueprism\OnlineTIAWorkingDir\ReferenceJsonExtracted

# ----- Logging -----

LOG_DIR=C:\blueprism\OnlineTIAWorkingDir\Logs
# LOG_LEVEL: one of DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
# Unknown / empty values fall back to INFO.
LOG_LEVEL=INFO

# ----- SS&C Cloud AI Gateway (chat-completions + RAG) -----

SSC_CLOUD_AIGATEWAY_API_KEY=<paste your api key>
SSC_CLOUD_AIGATEWAY_USER_ID=<paste your user id, e.g. user-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx>
SSC_CLOUD_AIGATEWAY_BASE_URL=https://api-ai.ssnc.cloud/v1
SSC_CLOUD_RAG_BASE_URL=https://api-ai-us.ssnc-corp.cloud
SSC_CLOUD_AIGATEWAY_MODEL=global.anthropic.claude-sonnet-4-6

# Use-case identifier for AI Gateway billing / governance
USE_CASE_ID=<paste your use case id, e.g. use-case-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx>
